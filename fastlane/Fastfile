require 'dotenv'
Dotenv.overload(File.join(File.dirname(__FILE__), '.env'))

default_platform(:ios)

platform :ios do

  APP_BUNDLE_ID = "com.keisukearai.ios-clipboard"
  $release_cleanup = { version_id: nil, client: nil }

  def api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
    )
  end

  PBXPROJ = File.expand_path("../ios-clipboard.xcodeproj/project.pbxproj", __dir__)

  def current_version
    File.read(PBXPROJ).scan(/MARKETING_VERSION = ([^;]+);/).map { |m| m[0].strip }.uniq.max
  end

  def bump_version_and_build!(new_ver)
    content = File.read(PBXPROJ)

    # MARKETING_VERSION を全 configuration に書き込む
    content = content.gsub(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{new_ver};")

    # CURRENT_PROJECT_VERSION を最大値 + 1 にする
    builds = content.scan(/CURRENT_PROJECT_VERSION = (\d+);/).map { |m| m[0].to_i }
    new_build = builds.max.to_i + 1
    content = content.gsub(/CURRENT_PROJECT_VERSION = \d+;/, "CURRENT_PROJECT_VERSION = #{new_build};")

    File.write(PBXPROJ, content)

    # 確実に書き込まれたか検証
    verify = File.read(PBXPROJ)
    UI.user_error!("MARKETING_VERSION の書き込み失敗: #{new_ver} になっていません") \
      unless verify.include?("MARKETING_VERSION = #{new_ver};")
    UI.user_error!("CURRENT_PROJECT_VERSION の書き込み失敗: #{new_build} になっていません") \
      unless verify.include?("CURRENT_PROJECT_VERSION = #{new_build};")

    UI.success("pbxproj を直接更新: version=#{new_ver}, build=#{new_build}")
    new_build
  end

  # ASC REST API クライアント（JWT認証）
  def make_asc_client
    require 'jwt'
    require 'openssl'
    require 'net/http'
    require 'json'

    private_key = OpenSSL::PKey::EC.new(File.read(ENV["ASC_KEY_FILEPATH"]))
    jwt_token = JWT.encode(
      { iss: ENV["ASC_ISSUER_ID"], iat: Time.now.to_i, exp: Time.now.to_i + 1200, aud: "appstoreconnect-v1" },
      private_key, "ES256",
      { kid: ENV["ASC_KEY_ID"], typ: "JWT" }
    )

    http = Net::HTTP.new("api.appstoreconnect.apple.com", 443)
    http.use_ssl = true

    {
      get: ->(path) {
        req = Net::HTTP::Get.new(path)
        req["Authorization"] = "Bearer #{jwt_token}"
        req["Content-Type"] = "application/json"
        JSON.parse(http.request(req).body)
      },
      post: ->(path, body) {
        req = Net::HTTP::Post.new(path)
        req["Authorization"] = "Bearer #{jwt_token}"
        req["Content-Type"] = "application/json"
        req.body = body
        resp = http.request(req)
        [resp.code.to_i, resp.body.empty? ? {} : JSON.parse(resp.body)]
      },
      patch: ->(path, body) {
        req = Net::HTTP::Patch.new(path)
        req["Authorization"] = "Bearer #{jwt_token}"
        req["Content-Type"] = "application/json"
        req.body = body
        resp = http.request(req)
        [resp.code.to_i, resp.body.empty? ? {} : JSON.parse(resp.body)]
      },
      delete: ->(path) {
        req = Net::HTTP::Delete.new(path)
        req["Authorization"] = "Bearer #{jwt_token}"
        resp = http.request(req)
        resp.code.to_i
      }
    }
  end

  def get_app_id(client)
    resp = client[:get].call("/v1/apps?filter[bundleId]=#{APP_BUNDLE_ID}")
    id = resp.dig("data", 0, "id")
    UI.user_error!("App not found in App Store Connect") unless id
    id
  end

  # 無料価格スケジュールを設定（manualPricesが未設定の場合のみ）
  def ensure_free_pricing(client, app_id)
    price_data = client[:get].call("/v1/apps/#{app_id}/appPriceSchedule")
    if price_data["data"]
      schedule_id = price_data.dig("data", "id")
      prices = client[:get].call("/v1/appPriceSchedules/#{schedule_id}/manualPrices")
      if prices["data"] && !prices["data"].empty?
        UI.success("Pricing already configured, skipping")
        return
      end
      UI.message("Price schedule exists but has no prices, will recreate with prices")
    end

    points = client[:get].call("/v1/apps/#{app_id}/appPricePoints?filter[territory]=USA")
    free_point = points["data"]&.find { |p| p.dig("attributes", "customerPrice").to_f == 0 }
    UI.user_error!("Free price point not found") unless free_point

    code, result = client[:post].call("/v1/appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        relationships: {
          app: { data: { type: "apps", id: app_id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${price}" }] }
        }
      },
      included: [{
        type: "appPrices",
        id: "${price}",
        attributes: { startDate: nil },
        relationships: {
          appPricePoint: { data: { type: "appPricePoints", id: free_point["id"] } }
        }
      }]
    }.to_json)

    code == 201 ? UI.success("App pricing set to free") : UI.user_error!("Failed to set pricing: #{result}")
  end

  # 全Territory の配信設定（未設定の場合のみ）
  def ensure_availability(client, app_id)
    territories = client[:get].call("/v1/territories?limit=200")
    territory_ids = territories["data"]&.map { |t| t["id"] } || []
    return if territory_ids.empty?

    ta_included = territory_ids.each_with_index.map do |tid, i|
      { type: "territoryAvailabilities", id: "${ta_#{i}}", attributes: { available: true, releaseDate: nil, preOrderEnabled: false }, relationships: { territory: { data: { type: "territories", id: tid } } } }
    end
    ta_refs = territory_ids.each_with_index.map { |_, i| { type: "territoryAvailabilities", id: "${ta_#{i}}" } }

    code, result = client[:post].call("/v2/appAvailabilities", {
      data: {
        type: "appAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: {
          app: { data: { type: "apps", id: app_id } },
          territoryAvailabilities: { data: ta_refs }
        }
      },
      included: ta_included
    }.to_json)

    if code == 201
      UI.success("App set to available in #{territory_ids.length} territories")
    elsif code == 409
      UI.success("App availability already configured, skipping")
    else
      UI.error("Failed to set availability: #{result}")
    end
  end

  # バイナリ処理完了を待機（processingState == "VALID" になるまでポーリング）
  def wait_for_build_processing(client, version_id, timeout: 600)
    UI.message("バイナリ処理完了を待機中（最大#{timeout}秒）...")
    started = Time.now
    loop do
      resp = client[:get].call("/v1/appStoreVersions/#{version_id}/build")
      state = resp.dig("data", "attributes", "processingState")
      if state == "VALID"
        UI.success("バイナリ処理完了")
        return
      elsif state == "INVALID"
        UI.user_error!("バイナリ処理に失敗しました (INVALID)")
      elsif state.nil?
        UI.message("バイナリをまだ受信中...")
      else
        UI.message("バイナリ処理中 (#{state})...")
      end
      elapsed = Time.now - started
      UI.user_error!("バイナリ処理がタイムアウトしました (#{timeout}s)") if elapsed > timeout
      sleep(20)
    end
  end

  # PREPARE_FOR_SUBMISSION 状態のバージョンを審査提出（新 reviewSubmissions API）
  def submit_version(client, app_id)
    versions = client[:get].call("/v1/apps/#{app_id}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION")
    version = versions["data"]&.first
    UI.user_error!("No version in PREPARE_FOR_SUBMISSION state found") unless version
    version_id = version["id"]
    UI.message("Found version #{version.dig('attributes', 'versionString')} (#{version_id})")

    # バイナリ処理・リンクが完了するまで待機
    wait_for_build_processing(client, version_id)

    # ビルドが version にリンクされているか確認
    b_resp = client[:get].call("/v1/appStoreVersions/#{version_id}/build")
    UI.user_error!("ビルドが version にリンクされていません") unless b_resp.dig("data", "attributes", "processingState") == "VALID"

    subs = client[:get].call("/v1/reviewSubmissions?filter[app]=#{app_id}&filter[platform]=IOS&filter[state]=READY_FOR_REVIEW,WAITING_FOR_REVIEW")
    submission_id = subs.dig("data", 0, "id")

    unless submission_id
      code, result = client[:post].call("/v1/reviewSubmissions", {
        data: {
          type: "reviewSubmissions",
          attributes: { platform: "IOS" },
          relationships: { app: { data: { type: "apps", id: app_id } } }
        }
      }.to_json)
      UI.user_error!("Failed to create review submission: #{result}") unless code == 201
      submission_id = result.dig("data", "id")
      UI.message("Created review submission #{submission_id}")
    end

    code, result = client[:post].call("/v1/reviewSubmissionItems", {
      data: {
        type: "reviewSubmissionItems",
        relationships: {
          reviewSubmission: { data: { type: "reviewSubmissions", id: submission_id } },
          appStoreVersion: { data: { type: "appStoreVersions", id: version_id } }
        }
      }
    }.to_json)
    UI.user_error!("Failed to add item (HTTP #{code}): #{result}") unless [201, 409].include?(code)

    code, result = client[:patch].call("/v1/reviewSubmissions/#{submission_id}", {
      data: {
        type: "reviewSubmissions",
        id: submission_id,
        attributes: { submitted: true }
      }
    }.to_json)
    code == 200 ? UI.success("Submitted for review!") : UI.user_error!("Failed to submit: #{result}")
  end

  # 年齢レーティング 4+ を設定（appInfos 経由）
  def ensure_age_rating(client, app_id)
    infos = client[:get].call("/v1/apps/#{app_id}/appInfos")
    info = infos["data"]&.find { |i| i.dig("attributes", "appStoreState") == "PREPARE_FOR_SUBMISSION" }
    info ||= infos["data"]&.first
    unless info
      UI.message("No appInfo found, skipping age rating")
      return
    end

    info_id = info["id"]
    rating_resp = client[:get].call("/v1/appInfos/#{info_id}/ageRatingDeclaration")
    rating_id = rating_resp.dig("data", "id")
    unless rating_id
      UI.message("Age rating declaration not found, skipping")
      return
    end

    attrs = rating_resp.dig("data", "attributes")
    if attrs && !attrs["advertising"].nil?
      UI.success("Age rating already configured, skipping")
      return
    end

    code, result = client[:patch].call("/v1/ageRatingDeclarations/#{rating_id}", {
      data: {
        type: "ageRatingDeclarations",
        id: rating_id,
        attributes: {
          ageAssurance: false,
          advertising: false,
          alcoholTobaccoOrDrugUseOrReferences: "NONE",
          contests: "NONE",
          gambling: false,
          gamblingSimulated: "NONE",
          gunsOrOtherWeapons: "NONE",
          healthOrWellnessTopics: false,
          horrorOrFearThemes: "NONE",
          lootBox: false,
          matureOrSuggestiveThemes: "NONE",
          medicalOrTreatmentInformation: "NONE",
          messagingAndChat: false,
          parentalControls: false,
          profanityOrCrudeHumor: "NONE",
          sexualContentGraphicAndNudity: "NONE",
          sexualContentOrNudity: "NONE",
          unrestrictedWebAccess: false,
          userGeneratedContent: false,
          violenceCartoonOrFantasy: "NONE",
          violenceRealistic: "NONE",
          violenceRealisticProlongedGraphicOrSadistic: "NONE",
        }
      }
    }.to_json)

    code == 200 ? UI.success("Age rating set to 4+") : UI.error("Failed to set age rating: #{result}")
  end

  # バージョンの whatsNew を locale ごとに直接 PATCH（deliver のアプリ名問題を回避）
  def upload_whats_new(client, app_id)
    notes_dir = File.expand_path("../metadata", __FILE__)
    notes = {}
    Dir.glob("#{notes_dir}/*/release_notes.txt").each do |path|
      locale = File.basename(File.dirname(path))
      notes[locale] = File.read(path).strip
    end
    return if notes.empty?

    all_vers = client[:get].call("/v1/apps/#{app_id}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION&filter[platform]=IOS")
    ver = all_vers["data"]&.first
    UI.user_error!("リリースノート更新: PREPARE_FOR_SUBMISSION バージョンが見つかりません") unless ver
    ver_id = ver["id"]

    locs = client[:get].call("/v1/appStoreVersions/#{ver_id}/appStoreVersionLocalizations")
    existing = {}
    (locs["data"] || []).each { |l| existing[l.dig("attributes", "locale")] = l["id"] }

    notes.each do |locale, text|
      if existing[locale]
        loc_id = existing[locale]
        code, result = client[:patch].call("/v1/appStoreVersionLocalizations/#{loc_id}", {
          data: { type: "appStoreVersionLocalizations", id: loc_id, attributes: { whatsNew: text } }
        }.to_json)
        code == 200 ? UI.success("Release notes updated: #{locale}") : UI.error("Failed #{locale}: #{result}")
      else
        code, result = client[:post].call("/v1/appStoreVersionLocalizations", {
          data: {
            type: "appStoreVersionLocalizations",
            attributes: { locale: locale, whatsNew: text },
            relationships: { appStoreVersion: { data: { type: "appStoreVersions", id: ver_id } } }
          }
        }.to_json)
        code == 201 ? UI.success("Release notes created: #{locale}") : UI.message("Release notes for #{locale} could not be created (HTTP #{code}): #{result}")
      end
    end
  end

  # App Privacy（データ収集なし）を申告
  lane :upload_privacy do
    client = make_asc_client
    app_id = get_app_id(client)

    resp = client[:get].call("/v1/apps/#{app_id}/appPrivacyDetails")
    privacy_id = resp.dig("data", "id")
    UI.user_error!("App privacy details not found") unless privacy_id

    code, result = client[:patch].call("/v1/appPrivacyDetails/#{privacy_id}", {
      data: {
        type: "appPrivacyDetails",
        id: privacy_id,
        attributes: { doesNotCollect: true }
      }
    }.to_json)

    code == 200 ? UI.success("App privacy set to 'does not collect data'") : UI.user_error!("Failed to update privacy: #{result}")
  end

  # メタデータのみアップロード
  lane :upload_metadata do
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      app_version: current_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      force: true,
      copyright: "#{Time.now.year} Keisuke Arai",
      app_review_information: {
        first_name: "Keisuke",
        last_name: "Arai",
        phone_number: ENV["REVIEW_PHONE"],
        email_address: ENV["REVIEW_EMAIL"],
        demo_user: "",
        demo_password: "",
        notes: "No sign-in is required. All features are available immediately after launch.",
      },
    )
  end

  # スクリーンショットのみアップロード
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      app_version: current_version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  # TestFlight にアップロード
  lane :beta do
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios-clipboard.xcodeproj",
      team_id: ENV["TEAM_ID"],
    )
    increment_build_number(xcodeproj: "ios-clipboard.xcodeproj")
    build_app(
      scheme: "ios-clipboard",
      export_method: "app-store",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["TEAM_ID"],
      },
    )
    upload_to_testflight(api_key: api_key)
  end

  # 審査提出のみ（バイナリ提出済みの場合）
  lane :submit do
    client = make_asc_client
    app_id = get_app_id(client)
    submit_version(client, app_id)
  end

  # App Store に申請
  lane :release do
    client = make_asc_client
    $release_cleanup[:client] = client
    app_id = get_app_id(client)
    ensure_free_pricing(client, app_id)
    ensure_availability(client, app_id)

    # PREPARE_FOR_SUBMISSION のバージョンが既にある場合は再利用、なければ新規作成
    pending = client[:get].call("/v1/apps/#{app_id}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION&filter[platform]=IOS")
    existing_pending = pending["data"]&.first

    if existing_pending
      new_ver = existing_pending.dig("attributes", "versionString")
      UI.success("既存の PREPARE_FOR_SUBMISSION バージョン #{new_ver} を再利用します（バイナリは上書きアップロード）")
      # 自分で作ったわけではないので error block では削除しない（version_id はセットしない）
    else
      # ビルド前に ASC へバージョンを作成して利用可能か確認（削除済み版は再利用不可）
      current_ver = current_version
      all_vers = client[:get].call("/v1/apps/#{app_id}/appStoreVersions?filter[platform]=IOS&limit=200")
      asc_versions = all_vers["data"]&.map { |v| v.dig("attributes", "versionString") } || []
      UI.message("Existing App Store versions: #{asc_versions.sort.join(', ')}")

      base_parts = ([current_ver] + asc_versions)
        .map { |v| v.split(".").map(&:to_i) }
        .max_by { |p| p }
      base_parts[-1] += 1
      new_ver = base_parts.join(".")

      attempt = 0
      loop do
        attempt += 1
        code, result = client[:post].call("/v1/appStoreVersions", {
          data: {
            type: "appStoreVersions",
            attributes: { platform: "IOS", versionString: new_ver },
            relationships: { app: { data: { type: "apps", id: app_id } } }
          }
        }.to_json)
        if code == 201
          $release_cleanup[:version_id] = result.dig("data", "id")
          UI.success("Created App Store version #{new_ver}")
          break
        elsif result.to_s.include?("previously used") || result.to_s.include?("already been used")
          UI.message("Version #{new_ver} already used in ASC, trying next...")
          parts = new_ver.split(".").map(&:to_i)
          if attempt >= 5
            UI.message("#{parts[0]}.x 系列で5回連続失敗、#{parts[0]+1}.0 にジャンプします")
            parts = [parts[0] + 1, 0]
            attempt = 0
          else
            parts[-1] += 1
          end
          new_ver = parts.join(".")
        else
          UI.user_error!("Failed to create App Store version #{new_ver} (HTTP #{code}): #{result}")
        end
      end
    end

    # pbxproj を直接書き換えてバージョン・ビルド番号を確実に更新（agvtool 不使用）
    new_build = bump_version_and_build!(new_ver)

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios-clipboard.xcodeproj",
      team_id: ENV["TEAM_ID"],
    )
    build_app(
      scheme: "ios-clipboard",
      export_method: "app-store",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["TEAM_ID"],
      },
    )

    # バイナリ・メタデータ・スクリーンショット（前バージョンから継承）をアップロード
    # skip_app_version_update: false にすることで deliver がスクリーンショット等を引き継ぐ
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_BUNDLE_ID,
      app_version: new_ver,
      submit_for_review: false,
      skip_screenshots: false,
      overwrite_screenshots: false,
      skip_metadata: false,
      skip_app_version_update: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      app_review_information: {
        first_name: "Keisuke",
        last_name: "Arai",
        phone_number: ENV["REVIEW_PHONE"],
        email_address: ENV["REVIEW_EMAIL"],
        demo_user: "",
        demo_password: "",
        notes: "No sign-in is required. All features are available immediately after launch.",
      },
    )

    # リリースノートを ASC REST API で直接更新（deliver のアプリ名問題を回避）
    upload_whats_new(client, app_id)

    # 年齢レーティング 4+ を設定
    ensure_age_rating(client, app_id)

    # 審査提出（ASC REST API で直接 POST）
    submit_version(client, app_id)

    # 全工程成功時のみ git にコミット
    git_commit(
      path: ["ios-clipboard.xcodeproj/project.pbxproj"],
      message: "Bump version to #{new_ver} (build #{new_build})",
    )
  end

  error do |lane, exception|
    # 事前作成した ASC バージョンを削除してバージョン文字列を解放
    if $release_cleanup[:version_id] && $release_cleanup[:client]
      begin
        del_code = $release_cleanup[:client][:delete].call("/v1/appStoreVersions/#{$release_cleanup[:version_id]}")
        UI.success("ASC バージョンを削除しました (HTTP #{del_code})")
      rescue => e
        UI.error("ASC バージョンの削除に失敗: #{e.message}")
      end
    end
    $release_cleanup = { version_id: nil, client: nil }
    # 失敗時はバージョン・ビルド番号の変更をロールバック
    reset_git_repo(
      force: true,
      files: ["ios-clipboard.xcodeproj/project.pbxproj"],
    )
    UI.error("Lane '#{lane}' failed: #{exception.message}. project.pbxproj を元に戻しました。")
  end

end
